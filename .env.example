# ============================================================================
# Numeraire++ — environment template
#
# Copy to `.env` (already gitignored) and adjust values for your local setup.
# Loaded at runtime by numeraire::utils::EnvLoader (Sprint 2+).
# Real env vars (`export FOO=bar`) override values from this file.
# ============================================================================

# --- Logging ----------------------------------------------------------------
# Levels: trace | debug | info | warn | error | critical (no inline comments on value lines — EnvLoader keeps text after '=' as-is)
NUMERAIRE_LOG_LEVEL=info
NUMERAIRE_LOG_FILE=logs/numeraire.log

# --- Database (Stage 2+) ----------------------------------------------------
# Default local file at repo root (see .gitignore `db.sqlite3`); overrides configs/default.json database.path when set.
NUMERAIRE_DB_PATH=db.sqlite3

# --- Market data providers (Stage 3+) ---------------------------------------
# POLYGON_API_KEY=
# POLYGON_BASE_URL=https://api.polygon.io
# Same API on rebranded host: https://api.massive.com
# Local futures product catalog (energy/metals → futures_product):
#   python3 scripts/fetch_massive_futures_products.py
# `dev_main --fetch-option-contracts` needs Options API access and prior `index_daily_eod` rows for --index-ticker.
#
# Polygon HTTP throttle (seconds after each REST call; 0 = no sleep):
#   Separate equity/index vs options — typical: equity basic (5/min), options starter (unlimited).
# NUMERAIRE_POLYGON_EQUITY_PLAN=basic
# NUMERAIRE_POLYGON_OPTIONS_PLAN=starter
# NUMERAIRE_POLYGON_FUTURES_PLAN=starter
# Or explicit seconds (override plan): NUMERAIRE_POLYGON_EQUITY_SLEEP_SEC=13
# NUMERAIRE_POLYGON_OPTIONS_SLEEP_SEC=0
# NUMERAIRE_POLYGON_FUTURES_SLEEP_SEC=0
# Legacy fallback for both when category-specific vars unset:
# NUMERAIRE_POLYGON_SLEEP_SEC_AFTER_CALL=13

# --- FRED (US Treasury / discount curve — second data provider) ---------------
# Free API key: https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY=
# FRED_BASE_URL=https://api.stlouisfed.org/fred
# Ingest + bootstrap (daily_market_prep.sh, FRED lag T-2): par_curve_* → discount_curve_*.
# Stored as curve_id USD_TREASURY_PAR_FRED (see configs/fred_usd_treasury_par_curve.json).

# --- dev_main sandbox — price one trade from SQLite -----------------------------
# Used when `./build/dev_main` is launched without a positional trade_id argument.
NUMERAIRE_DEV_TRADE_ID=TRD_001

# Synthetic BS inputs unless spot is sourced from DB (underlying id ↔ equity_daily_eod ticker).
NUMERAIRE_DEV_SPOT_SOURCE=env
# Spot from `equity_daily_eod.close` when SPOT_SOURCE=db (valuation calendar date below).
NUMERAIRE_DEV_AS_OF=
NUMERAIRE_DEV_SPOT_ADJUSTED=1
NUMERAIRE_DEV_SPOT=240
NUMERAIRE_DEV_RATE=0.03
NUMERAIRE_DEV_RATE_SOURCE=env
# Continuous zero rate from discount_curve_eod when RATE_SOURCE=db (run scripts/daily_market_prep.sh first).
# NUMERAIRE_DEV_DISCOUNT_CURVE_ID=USD_TREASURY_PAR_FRED
NUMERAIRE_DEV_VOL=0.20
NUMERAIRE_DEV_VOL_SOURCE=env
# Implied vol from vol_surface_eod when VOL_SOURCE=db (run scripts/daily_market_prep.sh first).
NUMERAIRE_DEV_DIV_YIELD=0
# When set, dev_main upserts trade_leg_mtm_eod per leg (requires NUMERAIRE_DEV_AS_OF or --as-of).

# --- Historical GBM calibration (--calibrate-historical-gbm) -----------------
# Defaults for `dev_main --calibrate-historical-gbm` (CLI flags override these).
# Persists vol / correlation / Cholesky into `historical_calibration_*` tables.
# NUMERAIRE_CALIB_AS_OF=2026-06-01
# NUMERAIRE_CALIB_BOOK=BOOK_1
# NUMERAIRE_CALIB_LOOKBACK_DAYS=504
# NUMERAIRE_CALIB_MIN_RETURN_OBS=60
# NUMERAIRE_CALIB_VOL_ANNUALIZATION_DAYS=252
# NUMERAIRE_CALIB_EOD_ADJUSTED=1

# --- Binomial tree (CRR / American equity vanilla) -----------------------------
# Tree step count (env overrides configs/default.json → pricing.binomial.default_steps).
# American early exercise is checked at every tree step (not a Bermudan date list).
# NUMERAIRE_BINOMIAL_STEPS=200

# --- Monte Carlo MTM pricer (informational mark for European vanillas) ---------
# Defaults: configs/default.json → pricing.monte_carlo_pricer (10000 paths, seed 42).
# Separate from NUMERAIRE_MC_* below, which sizes the exposure simulation: this engine
# draws one terminal value per path, so paths only set the sampling error (~1/sqrt(N),
# written per mark into trade_leg_mtm_eod.remarks).
# NUMERAIRE_MC_PRICER_PATHS=10000
# NUMERAIRE_MC_PRICER_SEED=42

# --- Monte Carlo simulation (`dev_main --simulate`) ----------------------------
# Requires a monthly calibration per portfolio (`--calibrate-historical-gbm --book BOOK_X`).
# Default path count: configs/default.json → pricing.monte_carlo.default_paths (1000).
# NUMERAIRE_SIM_BOOK=BOOK_1
# NUMERAIRE_MC_PATHS=1000
# NUMERAIRE_MC_SEED=42
# CSV exports under exports/ — one file per (book, as_of); re-run overwrites same path:
# path,factor,underlying_id,step,year_fraction,value
# NUMERAIRE_DUMP_SCENARIOS=exports/BOOK_1_2026-06-15_all_factors.csv
# Optional cap for debugging only (default: dump all simulated paths; viz subsamples when plotting):
# NUMERAIRE_DUMP_SCENARIOS_MAX_PATHS=50
# Path-wise leg exposure (requires --price-paths):
# path,leg_id,trade_id,pillar_id,step,year_fraction,pv_total,exposure
# NUMERAIRE_DUMP_LEG_EXPOSURE=exports/BOOK_1_2026-06-15_leg_exposure.csv
# NUMERAIRE_DUMP_LEG_EXPOSURE_MAX_PATHS=50
# Persist EE/PFE (95% and 97.5%; DB column pfe_975) per leg × pillar to trade_leg_exposure_eod
# (requires --price-paths). daily_book_mtm.sh runs this after MTM via daily_book_exposure.sh
# (passes --persist-exposure; no need to leave this set for cron).
# NUMERAIRE_PERSIST_EXPOSURE=1
# Skip CCR step after MTM: NUMERAIRE_SKIP_EXPOSURE=1
# IV/rate for path repricing use DB @ as_of (same as FO MTM when daily_market_prep ran):
# NUMERAIRE_DEV_DISCOUNT_CURVE_ID=USD_TREASURY_PAR_FRED
