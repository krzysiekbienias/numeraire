{
    "C_Cpp.intelliSenseEngine": "disabled",
    "C_Cpp.autocomplete": "disabled",
    "lldb.evaluateForHovers": false,
    "lldb.showDisassembly": "never",
    "cmake.debugConfig": {
        "type": "lldb",
        "request": "launch"
    },
    "cmake.ctest.neverDebugTestsWithLaunchConfiguration": true,
    "variableDisplayType.variableView": true,
    "variableDisplayType.watchView": true,
    "testMate.cpp.test.executables": "{build,out}/test_environment",
    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}/build",
        "--clang-tidy",
        "--header-insertion=iwyu",
        "--background-index",
        "--completion-style=detailed",
        "--all-scopes-completion",
        "--pch-storage=memory"
    ],
    "clangd.checkUpdates": false,
    "editor.formatOnSave": true,
    "[cpp]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },
    "[c]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },
    "files.associations": {
        "*.hpp": "cpp",
        "*.tpp": "cpp",
        "*.ipp": "cpp"
    },
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "markdown.math.enabled": true,
    "markdown.extension.math.enabled": false,
    "markdown.preview.scrollPreviewWithEditor": true,
    "markdown.preview.scrollEditorWithPreview": true,
    "markdown-preview-enhanced.mathRenderingOption": "KaTeX",
    "markdown-preview-enhanced.mathBlockDelimiters": [
        ["$$", "$$"],
        ["\\[", "\\]"]
    ],
    "markdown-preview-enhanced.mathInlineDelimiters": [
        ["\\(", "\\)"],
        ["$", "$"]
    ],
    "sqltools.connections": [
        {
            "previewLimit": 50,
            "driver": "SQLite",
            "name": "numeraire local",
            "database": "db.sqlite3"
        }
    ],
    "sqltools.useNodeRuntime": true
}
